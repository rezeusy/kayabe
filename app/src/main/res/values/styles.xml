<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomDatePickerStyle" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/colorPrimary</item>
        <item name="android:calendarTextColor">@android:color/black</item>
        <item name="android:datePickerMode">calendar</item>
        <item name="android:yearListItemTextAppearance">@style/CustomDatePickerTextAppearance</item>
        <item name="android:yearListSelectorColor">@color/colorPrimaryDark</item>
    </style>

    <style name="CustomDatePickerTextAppearance" parent="@android:style/TextAppearance.Widget.TextView.SpinnerItem">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="CustomOutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/black</item>
    </style>
    <style name="CustomHintTextAppearance" parent="TextAppearance.Design.Hint">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="CustomRadioButton">
        <item name="android:textColor">@android:color/black</item>
    </style>



</resources>