<!-- res/drawable/checkbox_textview_background.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state -->
    <item android:state_checked="true">
        <layer-list>
            <item android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3C6E71" /> <!-- Background color when checked -->
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:right="4dp" android:top="4dp" android:bottom="4dp" android:left="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" /> <!-- Checkmark color -->
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default (unchecked) state -->
    <item>
        <layer-list>
            <item android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" /> <!-- Background color when unchecked -->
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:right="4dp" android:top="4dp" android:bottom="4dp" android:left="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3C6E71" /> <!-- Checkmark color when unchecked -->
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
