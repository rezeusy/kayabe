<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white">

    <CheckBox
        android:id="@+id/checkBoxSeniorCitizen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senior Citizen"
        android:layout_marginTop="10dp"
        />

    <CheckBox
        android:id="@+id/checkBoxStudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student"
        android:layout_marginTop="10dp"
        />

    <CheckBox
        android:id="@+id/checkBoxPersonWithDisability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Person with Disability"
        />

    <CheckBox
        android:id="@+id/checkBoxNoDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="No Discount"
        />

    <Button
        android:id="@+id/buttonApplyDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="130dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="Apply"
        android:background="@color/black"
        android:textColor="@color/white"
        />
</LinearLayout>
