<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="40dp"
    android:theme="@style/Theme.MaterialComponents"
    android:orientation="vertical"
    android:background="@drawable/login_page"
    tools:context=".LoginActivity">


    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="190dp"
        style="@style/CustomOutlinedBox"
        app:hintTextColor="@color/black"
        android:textColorHint="#666666">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:fontFamily="@font/poppins"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/black" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Password TextInputLayout -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:passwordToggleEnabled="true"
        style="@style/CustomOutlinedBox"
        app:hintTextColor="@color/black"
        android:textColorHint="#666666">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:fontFamily="@font/poppins"
            android:inputType="textPassword"
            android:textColor="@android:color/black" />

    </com.google.android.material.textfield.TextInputLayout>


    <Button
        android:id="@+id/sign_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_button"
        android:textStyle="bold"
        android:textSize="20dp"
        android:text="Sign in"
        android:fontFamily="@font/poppinsbig"
        android:layout_marginTop="100dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="━━━━━━ Sign in with ━━━━━━"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/poppins"
        android:textAlignment="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">


        <ImageView
            android:id="@+id/btnGoogleSignIn"
            android:layout_marginTop="3dp"
            android:layout_width="30dp"
            android:layout_height="60dp"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:onClick="onSignInWithGoogleClick"
            android:src="@drawable/google_signin_button" />
        <Space
            android:layout_width="16dp"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnFacebookSignIn"
            android:layout_marginTop="3dp"
            android:layout_width="30dp"
            android:layout_height="60dp"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:onClick="onSignInWithFacebookClick"
            android:src="@drawable/facebook_signin_button" />
    </LinearLayout>


</androidx.appcompat.widget.LinearLayoutCompat>