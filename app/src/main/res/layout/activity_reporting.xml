<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppinsbig"
        android:gravity="center_horizontal"
        android:text="Share Your Feedback"
        android:textColor="@color/black"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="sans-serif"
        android:gravity="left"
        android:paddingStart="2dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="How satisfied are you in KAYABE App?"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="Very Disatisfied"
        android:layout_marginTop="20dp"

        android:textColor="#000000"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingStart="20dp">

        <RatingBar
            android:id="@+id/rbStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:numStars="5"
            android:paddingTop="20dp"
            android:progressBackgroundTint="#A5A5A5"
            android:progressTint="#EFB506" />

    </LinearLayout>

    <EditText
        android:id="@+id/etFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:background="#009688"
        android:ems="10"
        android:gravity="start|top"
        android:hint="Enter Your Feedback"
        android:inputType="textMultiLine"
        android:lines="10"
        android:padding="5dp"
        android:paddingStart="10dp"
        android:textColorHint="#C3C3C3" />

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="90dp"
        android:backgroundTint="@color/red"
        android:text="Send Feedback"

        android:background="@drawable/rounded_button"
        android:textColor="#ECECEC" />

</LinearLayout>